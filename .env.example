# === Copia este archivo a .env y rellena. NUNCA subas .env al repo. ===

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet para Ventas/Diagnóstico/Marketing, Haiku para el Perfilador (decisión del plan)
MODEL_VENTAS=claude-sonnet-5-5
MODEL_DIAGNOSTICO=claude-sonnet-5-5
MODEL_MARKETING=claude-sonnet-5-5
MODEL_PERFILADOR=claude-haiku-5-5
# Fallback automático si un safety classifier rechaza la petición (beta de Anthropic)
LLM_FALLBACKS=true
LLM_TIMEOUT_S=25
LLM_MAX_RETRIES=3

# --- Postgres (fuente de verdad de la ficha + checkpoints de LangGraph) ---
POSTGRES_USER=dzlabs
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=dzlabs
# Desde tu máquina (docker compose expone 5433; el 5432 suele estar ocupado por un PostgreSQL local):
DATABASE_URL=postgresql://dzlabs:cambia-esta-clave@localhost:5433/dzlabs

# --- API (FastAPI) ---
# Token que n8n/scripts deben enviar como "Authorization: Bearer <token>" a /inbound
INBOUND_API_TOKEN=genera-uno-con: python -c "import secrets;print(secrets.token_urlsafe(32))"
PUBLIC_BASE_URL=http://localhost:8000
ENV=dev
LOG_LEVEL=INFO
# Mensajes por minuto permitidos por cliente_id
RATE_LIMIT_PER_MINUTE=12

# --- n8n (bordes: avisos a Sebas, espejo Notion) ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/dzlabs-eventos
# Secreto compartido: la API firma cada POST a n8n con HMAC-SHA256 (header X-DZ-Signature)
# y n8n firma igual los POST a /webhooks/etapa
N8N_WEBHOOK_SECRET=genera-otro-secreto-largo
N8N_ENCRYPTION_KEY=clave-de-cifrado-de-credenciales-de-n8n
N8N_BASIC_AUTH_USER=sebas
N8N_BASIC_AUTH_PASSWORD=cambia-esta-clave

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Tu número para los avisos de handoff (E.164)
SEBAS_WHATSAPP=whatsapp:+57300...

# --- Agenda ---
CAL_BOOKING_URL=https://cal.com/dzlabs/15min

# --- Observabilidad (LangSmith). Pon LANGSMITH_TRACING=true y tu clave para ver trazas, tokens y costo ---
LANGSMITH_TRACING=false
# Crea la clave en smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=dzlabs-sales-engine
